{
  "name": "nexus-forge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Nexus Forge — cloud-first automated video production system (foundation phase). See docs/plans/000-architecture-discovery.md.",
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch --conditions=development apps/nexus/src/server-entry.ts",
    "dev:worker": "tsx watch --conditions=development apps/nexus/src/worker-entry.ts",
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "clean": "tsc -b tsconfig.json --clean",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node apps/nexus/dist/server-entry.js",
    "start:worker": "node apps/nexus/dist/worker-entry.js",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
