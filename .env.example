# Nexus Forge — environment configuration (example)
#
# Copy to `.env` and adjust. `.env` is git-ignored: NEVER commit real
# credentials (decision AD-12 in docs/plans/000-decisions.md).
# Every variable below has a safe default; an empty .env (or none at all)
# is valid for local development.

# ── Runtime ──────────────────────────────────────────────────────────────
# development | test | production
NEXUS_ENV=development

# Bind address. Default is loopback-only per AD-12 (no public surface).
# Set to 0.0.0.0 only inside containers / sandboxed preview environments.
NEXUS_HOST=127.0.0.1
NEXUS_PORT=8080

# fatal | error | warn | info | debug | trace | silent
NEXUS_LOG_LEVEL=info

# Root for all persistent state (SQLite DB + content-addressed artifact
# store arrive in a later phase). Relative paths resolve against the
# process working directory.
NEXUS_DATA_DIR=data

# ── Worker ───────────────────────────────────────────────────────────────
# Heartbeat interval (ms) for the worker entrypoint. The DB-backed job
# system (AD-05) is not implemented yet; the worker currently only proves
# the two-entrypoint deployment shape.
NEXUS_WORKER_HEARTBEAT_MS=30000

# ── Provider selection (AD-06) ───────────────────────────────────────────
# Which adapter serves each external capability. Registered adapters today:
#
#   llm         none | fake | manual | openai-compatible[:model]
#   research    none | fake | manual
#   tts         none | fake | manual
#   media       none | fake | manual
#   storage     none | fake | local          (no manual: a disk has no human)
#   publishing  none | fake | manual
#
# "none"   = refuse, actionably (the capability is not configured)
# "fake"   = deterministic, offline (also what --dry-run uses)
# "manual" = hand the step to a human and park the job at a gate
#
# Only append ":variant" to an adapter id — the first colon separates them, so
# model names with slashes (meta-llama/llama-3.1-8b-instruct) work as written.
# "openai-compatible" speaks to ANY OpenAI-shaped endpoint (OpenRouter, Groq,
# Together, a local llama.cpp server) — set NEXUS_LLM_BASE_URL/NEXUS_LLM_MODEL.
NEXUS_LLM_PROVIDER=none
NEXUS_TTS_PROVIDER=none
NEXUS_RESEARCH_PROVIDER=none
NEXUS_MEDIA_PROVIDER=none
# The local content-addressed store needs no account, so it is the default.
NEXUS_STORAGE_PROVIDER=local
NEXUS_PUBLISHING_PROVIDER=none

# ── Voice / audio (Phase 10) ─────────────────────────────────────────────
# Which voice narration is synthesized with. Empty = the configured adapter's
# own first voice, so nothing has to be guessed before a voice account exists.
NEXUS_TTS_VOICE=
# Container and numbers every synthesized segment is produced with. They are
# recorded in the audio artifact, so captions, mux and re-runs agree on them.
NEXUS_TTS_FORMAT=wav
NEXUS_TTS_SAMPLE_RATE=24000
NEXUS_TTS_RATE=1
# off | path — segment-level audio reuse, indexed by a JSON file at that path.
# Cached voice clips survive an edited script: only changed scenes are re-voiced.
NEXUS_AUDIO_SEGMENT_CACHE=off

# ── Provider call policy (AD-13) ─────────────────────────────────────────
# Applied to every capability by the shared invoke() pipeline.
NEXUS_PROVIDER_TIMEOUT_MS=30000
NEXUS_PROVIDER_MAX_ATTEMPTS=3
# on | off — content-hash cache under <NEXUS_DATA_DIR>/cache/providers
NEXUS_PROVIDER_CACHE=on
# Degrade a live provider to its "manual" fallback at this fraction of quota.
NEXUS_PROVIDER_DEGRADE_RATIO=0.9
# Self-imposed requests/minute ceiling (0 = no limit).
NEXUS_PROVIDER_RATE_LIMIT_PER_MIN=0

# Base URL + default model for the OpenAI-compatible LLM adapter (OD-3: the
# operator's provider choice). Validated as an http(s) URL at startup.
NEXUS_LLM_BASE_URL=https://openrouter.ai/api/v1
NEXUS_LLM_MODEL=meta-llama/llama-3.1-8b-instruct

# ── Provider credentials (AD-12) ─────────────────────────────────────────
# Secrets are NEVER written here, in the database, or in the repo. The system
# stores only the *name* of the variable that holds a credential (optionally
# per adapter in `provider_accounts.credentials_env`), and reads the value from
# the process environment at call time. Uncomment-and-export the ones you use:
#
#   export NEXUS_LLM_API_KEY=...
#   export NEXUS_RESEARCH_API_KEY=...
#   export NEXUS_TTS_API_KEY=...
#   export NEXUS_MEDIA_API_KEY=...
#   export NEXUS_YOUTUBE_CLIENT_SECRET=...
#
# A missing key fails the call with a ProviderAuthError naming the variable —
# it never silently degrades to a different provider.
